# Copy to .env and replace every example value before deployment.
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=https://your-school-platform-domain.example
SCHOOL_NAME=MyClassroom Academy

# Required only when creating the first administrator in a new production database.
BOOTSTRAP_ADMIN_NAME=Platform Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@your-school-domain.example
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-10-characters

# Local development only. Never enable demo seeding in production.
SEED_DEMO_DATA=false
